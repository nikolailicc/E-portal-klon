    @* Vidljivo svima koji su ulogovani *@
    <AuthorizeView>
        <Authorized>
            <div class="px-3 mb-1 text-uppercase text-white-50 fw-bold small">Nastava</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="courses">
                    <i class="bi bi-journal-text fs-5 lh-1 text-secondary"></i>
                    <span>Pregled predmeta</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Student">
        <Authorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="exams/register">
                    <i class="bi bi-pencil-square fs-5 lh-1 text-secondary"></i>
                    <span>Prijava ispita</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Profesor">
