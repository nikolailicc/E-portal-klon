    <AuthorizeView Roles="Administrator">
        <Authorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="users">
                    <i class="bi bi-people-fill fs-5 lh-1 text-secondary"></i>
                    <span>Lista korisnika</span>
                </NavLink>
            </div>
        </Authorized>
