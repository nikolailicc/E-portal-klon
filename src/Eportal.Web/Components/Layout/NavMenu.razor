    <AuthorizeView Roles="Administrator,StudentskaSluzba">
        <Authorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="courses/add">
                    <i class="bi bi-plus-circle-fill fs-5 lh-1 text-secondary"></i>
                    <span>Dodaj novi predmet</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="enroll">
                    <i class="bi bi-person-check-fill fs-5 lh-1 text-secondary"></i>
                    <span>Upis studenata na kurs</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administrator">
        <Authorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="study-programs">
                    <i class="bi bi-collection-fill fs-5 lh-1 text-secondary"></i>
                    <span>Studijski programi</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

