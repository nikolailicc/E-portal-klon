    <AuthorizeView Roles="Administrator,StudentskaSluzba">
        <Authorized>
            <hr class="border-secondary opacity-25 mx-3 my-2" />
            <div class="px-3 mb-1 text-uppercase text-white-50 fw-bold small">Administracija</div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="exams/periods">
                    <i class="bi bi-calendar-event-fill fs-5 lh-1 text-secondary"></i>
                    <span>Ispitni rokovi</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="exams/schedule">
                    <i class="bi bi-calendar-check-fill fs-5 lh-1 text-secondary"></i>
                    <span>Zakazivanje ispita</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center gap-2 text-light" href="register">
                    <i class="bi bi-person-plus-fill fs-5 lh-1 text-secondary"></i>
                    <span>Dodaj novi nalog</span>
                </NavLink>
            </div>
        </Authorized>
