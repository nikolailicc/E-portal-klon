@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">Prijavljen kao: @context.User.Identity?.Name</span>
                    
                    <form method="post" action="/logout" class="d-inline">
                        <button type="submit" class="btn btn-link">Odjavi se</button>
                    </form>
                    <a href="/profile" class="me-3">Moj profil</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Prijava</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>