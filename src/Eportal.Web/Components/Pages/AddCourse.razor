@page "/courses/add"
@page "/courses/edit/{Id:int}"
@attribute [Authorize(Roles = "Administrator,StudentskaSluzba,Profesor")]
@rendermode InteractiveServer

@using Eportal.Modules.Academic.Domain
@using Eportal.Modules.Academic.Infrastructure
@using Eportal.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims

@inject AcademicDbContext AcademicDb
@inject IUserLookupService UserLookup
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(IsEditing ? "Izmena predmeta" : "Dodavanje predmeta")</PageTitle>

<h3>@(IsEditing ? $"Izmena predmeta (ID: {Id})" : "Dodavanje novog predmeta")</h3>
<hr />

@if (professors is null)
{
    <p>Učitavanje formi...</p>
}
else if (professors.Count == 0)
{
    <div class="alert alert-warning">Nema profesora u sistemu. Nemoguće je kreirati predmet.</div>
}
else if (studyPrograms.Count == 0)
{
    <div class="alert alert-warning">Nema studijskih programa u sistemu.</div>
}
else
{
    <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="CourseForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label">Naziv</label>
            <InputText class="form-control" @bind-Value="model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Šifra</label>
            <InputText class="form-control" @bind-Value="model.Code" />
        </div>

        <div class="mb-3">
            <label class="form-label">ESPB</label>
            <InputNumber class="form-control" @bind-Value="model.Espb" />
        </div>

        <div class="mb-3">
            <label class="form-label">Semestar</label>
            <InputNumber class="form-control" @bind-Value="model.Semester" />
        </div>

        <div class="mb-3">
            <label class="form-label">Profesor</label>
            @* Zaključano ako je ulogovan profesor *@
            <InputSelect class="form-control" @bind-Value="model.ProfessorUserId" disabled="@isUserProfessor">
                <option value="">-- izaberi profesora --</option>
                @foreach (var p in professors)
                {
                    <option value="@p.UserId">@p.FirstName @p.LastName</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Studijski programi</label>
            @foreach (var sp in studyPrograms)
            {
                <div class="form-check form-check-inline">
                    <input type="checkbox"
                           class="form-check-input"
                           id="sp-@sp.Id"
                           checked="@selectedProgramIds.Contains(sp.Id)"
                           @onchange="e => ToggleProgram(sp.Id, (bool)e.Value!)"
                           disabled="@isUserProfessor" /> @* Zaključano ako je ulogovan profesor *@
                    <label class="form-check-label" for="sp-@sp.Id">@sp.Name</label>
                </div>
            }
        </div>

        <div class="mt-4">
            <button class="btn btn-primary" type="submit">
                @(IsEditing ? "Sačuvaj izmene" : "Dodaj predmet")
            </button>
            <button class="btn btn-secondary" type="button" @onclick="Cancel">
                Odustani
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private CourseModel model = new();
    private string? errorMessage;

    private List<UserSummaryDto>? professors;
    private List<StudyProgram> studyPrograms = new();
    private HashSet<int> selectedProgramIds = new();

    private bool isUserProfessor = false;

    private bool IsEditing => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        professors = await UserLookup.GetProfessorsAsync();
        studyPrograms = AcademicDb.StudyPrograms.OrderBy(x => x.Name).ToList();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        isUserProfessor = user.IsInRole("Profesor");

        if (IsEditing)
        {
            var course = await AcademicDb.Courses
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (course != null)
            {
                // Ako je profesor, a predmet nije njegov -> vrati ga na listu
                if (isUserProfessor && course.ProfessorUserId != userId)
                {
                    Navigation.NavigateTo("/courses");
                    return;
                }

                model = new CourseModel
                {
                    Name = course.Name,
                    Code = course.Code,
                    Espb = course.Espb,
                    Semester = course.Semester,
                    ProfessorUserId = course.ProfessorUserId
                };

                selectedProgramIds = AcademicDb.CourseStudyPrograms
                    .Where(x => x.CourseId == course.Id)
                    .Select(x => x.StudyProgramId)
                    .ToHashSet();
            }
            else
            {
                Navigation.NavigateTo("/courses");
            }
        }
        else
        {
            // Profesor ne može da dodaje nove predmete
            if (isUserProfessor)
            {
                Navigation.NavigateTo("/courses");
                return;
            }

            model = new CourseModel();
            selectedProgramIds.Clear();
        }
    }

    private void ToggleProgram(int programId, bool isChecked)
    {
        if (isChecked)
            selectedProgramIds.Add(programId);
        else
            selectedProgramIds.Remove(programId);
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/courses");
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(model.ProfessorUserId))
        {
            errorMessage = "Izaberi profesora.";
            return;
        }

        if (selectedProgramIds.Count == 0)
        {
            errorMessage = "Izaberi bar jedan program.";
            return;
        }

        if (AcademicDb.Courses.Any(x => x.Code == model.Code && x.Id != Id))
        {
            errorMessage = "Šifra predmeta već postoji.";
            return;
        }

        if (IsEditing)
        {
            var course = await AcademicDb.Courses.FirstOrDefaultAsync(x => x.Id == Id);
            if (course == null) return;

            course.Name = model.Name;
            course.Code = model.Code;
            course.Espb = model.Espb;
            course.Semester = model.Semester;

            // Za svaki slučaj, ako je profesor poslao zahtev, ne menjamo profesora i programe u bazi
            if (!isUserProfessor)
            {
                course.ProfessorUserId = model.ProfessorUserId;

                var oldLinks = AcademicDb.CourseStudyPrograms.Where(x => x.CourseId == course.Id);
                AcademicDb.CourseStudyPrograms.RemoveRange(oldLinks);

                foreach (var id in selectedProgramIds)
                {
                    AcademicDb.CourseStudyPrograms.Add(new CourseStudyProgram { CourseId = course.Id, StudyProgramId = id });
                }
            }
        }
        else
        {
            var course = new Course
            {
                Name = model.Name,
                Code = model.Code,
                Espb = model.Espb,
                Semester = model.Semester,
                ProfessorUserId = model.ProfessorUserId
            };

            AcademicDb.Courses.Add(course);
            await AcademicDb.SaveChangesAsync();

            foreach (var id in selectedProgramIds)
            {
                AcademicDb.CourseStudyPrograms.Add(new CourseStudyProgram { CourseId = course.Id, StudyProgramId = id });
            }
        }

        await AcademicDb.SaveChangesAsync();
        Navigation.NavigateTo("/courses");
    }

    public class CourseModel
    {
        [Required(ErrorMessage = "Naziv je obavezan.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Šifra je obavezna.")]
        public string Code { get; set; } = "";

        [Range(1, 20, ErrorMessage = "ESPB mora biti između 1 i 20.")]
        public int Espb { get; set; } = 6;

        [Range(1, 8, ErrorMessage = "Semestar mora biti između 1 i 8.")]
        public int Semester { get; set; } = 1;

        public string ProfessorUserId { get; set; } = "";
    }
}