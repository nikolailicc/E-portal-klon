@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]
@using Eportal.Modules.Identity.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject IJSRuntime JS

<PageTitle>Korisnici</PageTitle>

<h3>Upravljanje korisnicima</h3>

@if (users is null)
{
    <p>Učitavanje...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ime i prezime</th>
                <th>Email</th>
                <th>Uloga</th>
                <th>Status</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in users)
            {
                var isLocked = u.LockoutEnd is not null && u.LockoutEnd > DateTimeOffset.UtcNow;

                <tr>
                    <td>@u.FirstName @u.LastName</td>
                    <td>@u.Email</td>
                    <td>
                        <select class="form-select form-select-sm" style="width:auto; display:inline-block"
                                value="@u.Role"
                                @onchange="e => ChangeRole(u, e.Value!.ToString()!)">
                            @foreach (var role in Enum.GetValues<UserRole>())
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </td>
                    <td>
                        @if (isLocked)
                        {
                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => Activate(u)">Aktiviraj</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => Deactivate(u)">Deaktiviraj</button>
                        }
                        <button class="btn btn-sm btn-outline-dark" @onclick="() => Delete(u)">Obriši</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-2">@message</p>
}

@code {
    private List<AppUser>? users;
    private string? message;

    protected override void OnInitialized()
    {
        LoadUsers();
    }

    private void LoadUsers()
    {
        users = UserManager.Users.ToList();
    }

    private async Task ChangeRole(AppUser user, string newRoleName)
    {
        var newRole = Enum.Parse<UserRole>(newRoleName);

        var currentRoles = await UserManager.GetRolesAsync(user);
        await UserManager.RemoveFromRolesAsync(user, currentRoles);
        await UserManager.AddToRoleAsync(user, newRole.ToString());

        user.Role = newRole;
        await UserManager.UpdateAsync(user);

        message = $"Uloga korisnika {user.Email} promenjena u {newRole}.";
        LoadUsers();
    }

    private async Task Deactivate(AppUser user)
    {
        await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);
        message = $"Korisnik {user.Email} je deaktiviran.";
        LoadUsers();
    }

    private async Task Activate(AppUser user)
    {
        await UserManager.SetLockoutEndDateAsync(user, null);
        message = $"Korisnik {user.Email} je aktiviran.";
        LoadUsers();
    }
    private async Task Delete(AppUser user)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Trajno obrisati korisnika {user.Email}? Ova akcija se ne može poništiti.");

        if (!confirmed)
        {
            return;
        }

        await UserManager.DeleteAsync(user);

        message = $"Korisnik {user.Email} je obrisan.";
        LoadUsers();
    }

}