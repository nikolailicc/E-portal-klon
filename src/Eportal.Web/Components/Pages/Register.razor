@page "/register"
@attribute [Authorize(Roles = "Administrator,StudentskaSluzba")]
@using Eportal.Modules.Identity.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@inject UserManager<AppUser> UserManager

<PageTitle>Registracija</PageTitle>

<h3>Registracija</h3>

<EditForm Model="@model" OnValidSubmit="HandleRegister" FormName="register-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Ime</label>
        <InputText class="form-control" @bind-Value="model.FirstName" />
    </div>

    <div class="mb-3">
        <label>Prezime</label>
        <InputText class="form-control" @bind-Value="model.LastName" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>

    <div class="mb-3">
        <label>Lozinka</label>
        <InputText class="form-control" type="password" @bind-Value="model.Password" />
    </div>

    <div class="mb-3">
        <label>Uloga</label>
        <InputSelect class="form-control" @bind-Value="model.Role">
            @foreach (var role in allowedRoles)
            {
                <option value="@role">@role</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Registruj se</button>
</EditForm>

@if (!string.IsNullOrEmpty(resultMessage))
{
    <p class="mt-3">@resultMessage</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromForm]
    private RegisterModel? model { get; set; }

    private bool isAdmin;
    private List<UserRole> allowedRoles = new();
    private string? resultMessage;

    protected override async Task OnInitializedAsync()
    {
        model ??= new();

        var authState = await AuthStateTask!;
        isAdmin = authState.User.IsInRole("Administrator");

        allowedRoles = isAdmin
            ? new List<UserRole> { UserRole.Student, UserRole.Profesor, UserRole.StudentskaSluzba, UserRole.Administrator }
            : new List<UserRole> { UserRole.Student, UserRole.Profesor };

        if (!allowedRoles.Contains(model!.Role))
        {
            model.Role = allowedRoles[0];
        }
    }

    private async Task HandleRegister()
    {
        if (!allowedRoles.Contains(model!.Role))
        {
            resultMessage = "Nemaš dozvolu da dodeliš tu ulogu.";
            return;
        }

        var user = new AppUser
        {
            UserName = model.Email,
            Email = model.Email,
            FirstName = model.FirstName,
            LastName = model.LastName,
            Role = model.Role
        };

        var result = await UserManager.CreateAsync(user, model.Password);

        if (result.Succeeded)
        {
            await UserManager.AddToRoleAsync(user, user.Role.ToString());
            resultMessage = "Uspešno registrovan korisnik!";
        }
        else
        {
            resultMessage = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }

    public class RegisterModel
    {
        [Required] public string FirstName { get; set; } = "";
        [Required] public string LastName { get; set; } = "";
        [Required][EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        public UserRole Role { get; set; } = UserRole.Student;
    }
}